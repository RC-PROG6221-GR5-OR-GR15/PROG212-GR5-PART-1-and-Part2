@model IEnumerable<Maraton.mvc.Models.ViewModels.EventViewModel>
@{
    ViewData["Title"] = "Upcoming Events - RaceDay";
    var selectedType = ViewBag.SelectedType as string;
}

<div class="container mt-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h1 class="fw-bold text-primary"><i class="bi bi-calendar3"></i> Upcoming Events</h1>
            <p class="text-muted">Find your next challenge and join the community.</p>
        </div>
        <div class="col-md-6 text-md-end">
            <div class="btn-group shadow-sm" role="group">
                <a asp-action="Index" asp-route-type="All" class="btn btn-outline-primary @(selectedType == "All" ? "active" : "")">All</a>
                <a asp-action="Index" asp-route-type="Run" class="btn btn-outline-primary @(selectedType == "Run" ? "active" : "")"><i class="bi bi-person-walking"></i> Run</a>
                <a asp-action="Index" asp-route-type="Cycle" class="btn btn-outline-primary @(selectedType == "Cycle" ? "active" : "")"><i class="bi bi-bicycle"></i> Cycle</a>
                <a asp-action="Index" asp-route-type="Walk" class="btn btn-outline-primary @(selectedType == "Walk" ? "active" : "")"><i class="bi bi-universal-access"></i> Walk</a>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5 border-0 shadow-sm rounded-4">
            <i class="bi bi-info-circle display-4 mb-3 d-block text-primary"></i>
            <h3 class="fw-bold">No events found</h3>
            <p class="mb-0 text-muted">Check back soon for new events or try a different filter.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden event-card">
                        <div class="card-img-top bg-primary text-white d-flex align-items-center justify-content-center py-5 position-relative">
                            <i class="bi @(item.EventType == "Run" ? "bi-person-walking" : item.EventType == "Cycle" ? "bi-bicycle" : "bi-universal-access") display-1 opacity-25"></i>
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge rounded-pill bg-light text-primary fw-bold shadow-sm">@item.EventType</span>
                            </div>
                            <div class="position-absolute bottom-0 start-0 m-3 text-start">
                                <h4 class="mb-0 fw-bold">@item.DistanceKm km</h4>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <h5 class="card-title fw-bold text-dark mb-2">@item.EventName</h5>
                            <div class="d-flex align-items-center mb-2 text-muted small">
                                <i class="bi bi-calendar-event me-2"></i> @item.EventDate.ToString("dd MMM yyyy")
                            </div>
                            <div class="d-flex align-items-center mb-3 text-muted small">
                                <i class="bi bi-geo-alt me-2"></i> @item.Venue, @item.Location
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <h5 class="text-primary fw-bold mb-0">R @item.EventFee.ToString("F2")</h5>
                                <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                    VIEW DETAILS
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .event-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .event-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
    }
</style>
