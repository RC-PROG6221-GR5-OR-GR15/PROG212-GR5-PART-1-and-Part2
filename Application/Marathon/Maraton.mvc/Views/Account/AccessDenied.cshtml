@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5 text-center">
    <div class="alert alert-danger p-5 shadow">
        <h1 class="display-1 fw-bold text-danger"><i class="bi bi-shield-lock-fill"></i></h1>
        <h2 class="fw-bold">403 - ACCESS DENIED</h2>
        <hr />
        <p class="lead">Oops! You don't have permission to enter this area.</p>
        <p class="text-muted">This page is restricted to athletes with a different role.</p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-danger btn-lg px-4 fw-bold">
                RETURN HOME
            </a>
        </div>
    </div>
</div>
